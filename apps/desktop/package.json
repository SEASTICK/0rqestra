{
  "name": "@0rqestra/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "0rqestra desktop app (Electron).",
  "author": "0rqestra contributors",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build-ui.mjs",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "smoke:failures": "npm run build && node scripts/verify-smoke-failures.mjs",
    "package": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.orqestra.desktop",
    "productName": "0rqestra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "update-config.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
